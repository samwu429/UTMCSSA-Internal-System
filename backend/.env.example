# Copy to .env and fill in real values. The .env file is gitignored; never commit credentials.
# 复制为 .env 并填入真实值。.env 已被 git 忽略，切勿提交任何凭证。

ENVIRONMENT=development
DEBUG=true
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=
API_BASE_PATH=/api/v1
FRONTEND_DIST_DIR=

# Neon connection string. The application rewrites sslmode into the form asyncpg expects, so the
# value can be pasted from the Neon dashboard unchanged.
# Neon 连接串。应用会自动把 sslmode 转换为 asyncpg 可接受的形式，可直接粘贴 Neon 控制台给出的值。
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

STUDENT_EMAIL_DOMAINS=["mail.utoronto.ca","utoronto.ca"]
ALUMNI_EMAIL_DOMAINS=["alum.utoronto.ca","alumni.utoronto.ca"]
EMAIL_VERIFICATION_CODE_LENGTH=6
EMAIL_VERIFICATION_TTL_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Resend API key. Leaving it empty switches the application to the console email transport, which
# writes verification codes to the log for local development.
# Resend API key。留空时应用切换为控制台邮件传输，将验证码写入日志供本地开发使用。
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=UTMCSSA <noreply@utmcssa.ca>
EMAIL_REPLY_TO_ADDRESS=

ORGANIZATION_TIMEZONE=America/Toronto
DAILY_DIGEST_HOUR=7
DAILY_DIGEST_MINUTE=0
SCHEDULER_ENABLED=true
CAMPUS_LATITUDE=43.5489
CAMPUS_LONGITUDE=-79.6625

# storage_driver is either "local" or "s3".
# storage_driver 取值为 "local" 或 "s3"。
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=var/document-vault
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_MAX_UPLOAD_BYTES=52428800

# First administrator created on startup. Remove both values once the account exists.
# 启动时创建的首位管理员。账号创建后请删除这两项。
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
